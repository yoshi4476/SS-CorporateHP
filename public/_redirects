# Cloudflare Pages のリダイレクト定義
# 静的書き出しでは next.config.ts の redirects() が無効になるため、ここで指定する。

# 事業統合: オウンドメディア → AIO運用代行
/services/owned-media   /services/aio   301
/services/owned-media/* /services/aio   301

# 旧サイト (WordPress) の継続事業: 店舗集客 G-ran → MEO運用代行
/g-ran            /services/meo   301
/g-ran/*          /services/meo   301

# 旧サイトの終了事業 (造園・草刈り・害虫害獣・不用品) → トップ
/landscaping      /   301
/landscaping/*    /   301
/mowing           /   301
/mowing/*         /   301
/pest-control     /   301
/pest-control/*   /   301
/unwanted-items   /   301
/unwanted-items/* /   301

# 旧サイトの対応事例 → 事業内容一覧
/case             /services   301
/case/*           /services   301
/case-cat/*       /services   301

# 経理BPOへテーマを変更した際に取り下げた採用・人材系の記事。
# 削除しただけだと404になり、検索結果やSNSからの流入を落とすため一覧へ送る。
/blog/arubaito-souki-rishoku-fusegu     /blog   301
/blog/biyoushitsu-staff-teichakuritsu   /blog   301
/blog/inshokuten-arubaito-saiyou-kotsu  /blog   301
/blog/kyuujinhyou-kakikata-tenpo        /blog   301
/blog/shift-sakusei-koritsuka           /blog   301
/blog/tencho-ikusei-houhou              /blog   301
/blog/tenpo-staff-kyouiku-manual        /blog   301

# /blog は新ブログ (自動化エンジンが記事を投入) が使うため、転送しない。
# 旧WordPressの記事URL (/blog/01/ 等) は404になる。移したい記事があれば
# Search Console でクリック数の多いものを確認し、個別に転送を追加すること。

# WordPress固有のパス
/wp-admin/*       /   302
/wp-login.php     /   302
/xmlrpc.php       /   302
