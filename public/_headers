# Cloudflare Pages のレスポンスヘッダー定義
#
# CSP は静的書き出しのため nonce を発行できず、Next.js が埋め込むインライン
# スクリプトと framer-motion のインラインスタイルを許可する必要がある。
# そのため script-src / style-src には 'unsafe-inline' を残している。
# 外部への接続先は、GA4 と お問い合わせフォームの送信先 (GAS) だけに絞る。

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://ai.7senses.co.jp https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://*.g.doubleclick.net; media-src 'self' https://ai.7senses.co.jp; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.g.doubleclick.net; form-action 'self'; upgrade-insecure-requests

# 内容が変わるとファイル名も変わるため、長期キャッシュして良い
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 画像は /images/ 配下にまとめている。拡張子で別ルールを足すと
# 両方が適用されてヘッダーが二重になるため、ここだけで指定する
/images/*
  Cache-Control: public, max-age=604800

# 検索エンジン向けのファイルは短めに
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
